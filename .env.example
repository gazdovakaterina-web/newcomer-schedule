# Supabase project settings — find these in your Supabase Dashboard under
# Project Settings → API.
#
# NEXT_PUBLIC_ prefixed vars are exposed to the browser. That's fine for
# both of these: the URL is not secret, and the anon key is meant to be
# public — Row Level Security (see supabase/schema.sql) is what actually
# restricts what it can read. NEVER put the service_role key in a
# NEXT_PUBLIC_ variable or ship it to the client.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Added in Phase 3, alongside the admin editor and Supabase Auth — not
# needed yet, but documented here so it's not a surprise later.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server-side only, never NEXT_PUBLIC_
